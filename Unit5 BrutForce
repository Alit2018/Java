void main() {

    int secretPin = 427;

    for (int i = 0; i <= 999; i++) {

        if (i == secretPin) {
            System.out.println("PIN found: " + i);
            break;
        }
    }
}


---------> or

void main() {

    String secretPin = "427";

    for (int i = 0; i <= 999; i++) {

        String guess = String.format("%03d", i);

        if (guess.equals(secretPin)) {
            System.out.println("PIN found: " + guess);
            break;
        }
    }
}
