import java.util.*;

class Q{
 int x,y=1;Q[]z=new Q[2];
 Q(int n){x=n;}
}

class W{
 private Q q;

 public void x(int n){q=x(q,n);}

 private Q x(Q a,int n){
  if(a==null)return new Q(n);
  int k=Integer.compare(n,a.x);
  if(k==0)return a;
  int i=(k+1)/2;
  a.z[i]=x(a.z[i],n);
  a.y=1+Math.max(y(a.z[0]),y(a.z[1]));
  int j=y(a.z[0])-y(a.z[1]);

  if(j>1){
   if(n>a.z[0].x)a.z[0]=r(a.z[0],1);
   return r(a,0);
  }

  if(j<-1){
   if(n<a.z[1].x)a.z[1]=r(a.z[1],0);
   return r(a,1);
  }

  return a;
 }

 private int y(Q a){
  return a==null?0:a.y;
 }

 private Q r(Q a,int i){
  int j=1-i;
  Q b=a.z[i],c=b.z[j];

  b.z[j]=a;
  a.z[i]=c;

  a.y=1+Math.max(y(a.z[0]),y(a.z[1]));
  b.y=1+Math.max(y(b.z[0]),y(b.z[1]));

  return b;
 }

 public void z(){
  z(q);
  System.out.println();
 }

 private void z(Q a){
  if(a==null)return;
  z(a.z[0]);
  System.out.print(a.x+" ");
  z(a.z[1]);
 }
}

public class Main{
 public static void main(String[]a){
  Scanner s=new Scanner(System.in);
  W w=new W();

  System.out.print("How many numbers would you like to add? ");
  int n=s.nextInt();

  while(n-->0){
   System.out.print("Enter a number: ");
   w.x(s.nextInt());
  }

  System.out.println("Your AVL tree in sorted order:");
  w.z();
  s.close();
 }
}
